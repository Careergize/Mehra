Set-Content -Path ".gitignore" -Value @"
# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
*.local

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories & IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
"@ -Encoding utf8